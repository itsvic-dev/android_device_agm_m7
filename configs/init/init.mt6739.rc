import /vendor/etc/init/hw/init.mainline.rc

on early-init
    write /sys/block/mmcblk1/queue/read_ahead_kb 512

on init
    setprop sys.usb.controller musb-hdrc.1.auto
    write /sys/block/zram0/comp_algorithm zstd

on fs
    mkdir /mnt/vendor/nvdata 0770 system system
    mkdir /mnt/vendor/protect_f 0770 system system
    mkdir /mnt/vendor/protect_s 0770 system system
    mount_all --early

# GPU: the DDK 1.9 firmware is in /vendor/firmware/powervr
on post-fs
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules powervr
    wait /dev/dri/renderD128

on late-fs
    mount_all --late

on boot
    swapon_all

# Wi-Fi: the module needs the CONSYS firmware from /vendor and the NVRAM from /mnt/vendor/nvdata
# TODO: decide between modules.load (dlkm_loader_mainline) and this explicit load
on post-fs-data
    mkdir /data/vendor/wifi 0770 wifi wifi
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules mt6739-wlan

# Debug: logcat on /metadata, which NixOS can read after a reset
on post-fs
    mkdir /metadata/logcat 0770 root log

on post-fs-data
    start vendor.logcat_metadata

service vendor.logcat_metadata /system/bin/logcat -b all -v threadtime -f /metadata/logcat/logcat -r 1024 -n 4
    user root
    group log
    seclabel u:r:logpersist:s0
    disabled

# The default 3.3 MiB reserve lets a full page cache starve atomic allocations in the USB gadget
on boot
    write /proc/sys/vm/min_free_kbytes 16384

# Modem: NVRAM file service on a copy of the stock NVRAM, then the modem start
on post-fs-data
    mkdir /data/vendor/ccci-fs 0700 radio radio
    # radio reads the stock radio:radio files, system the root:system ones
    exec - radio radio system -- /vendor/bin/ccci-fs-seed
    start vendor.ccci-fsd

on property:init.svc.vendor.ccci-fsd=running
    write /sys/bus/platform/drivers/mt6739-ccci/10014000.modem/state 1
    wait /dev/wwan0at0 30
    setprop vendor.modem.ready 1

service vendor.ccci-fsd /vendor/bin/ccci-fsd /dev/ccci_fs /data/vendor/ccci-fs
    class main
    user radio
    group radio system
    disabled
