# Applied on top of arch/arm64/configs/agm-m7.config in linux-mt6739 (linux-7.2).
# Reference: kernel/configs/b/android-6.12/android-base.config and
# kernel/mainline/configs/fragments/common.config in this tree.
# TODO: run kernel/mainline/configs/utilities/validate_kernel_config.py against the result

# Binder (C implementation; drop binder.impl=rust from the cmdline)
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
# binderfs creates these at mount; init.rc links /dev/{binder,hwbinder,vndbinder} to them
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# SELinux and audit
CONFIG_AUDIT=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_LSM="selinux,bpf"
CONFIG_SECCOMP_FILTER=y
CONFIG_STATIC_USERMODEHELPER=y

# Memory (MEMCG is on already; slub_debug=- stays on the cmdline)
CONFIG_PSI=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_USERFAULTFD=y
# bionic uses tagged heap pointers on arm64
CONFIG_ARM64_TAGGED_ADDR_ABI=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_SYNC_FILE=y

# cgroups used by cgroups.json and task_profiles.json
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
# cgroups.json mounts blkio and cpuset as v1 hierarchies
CONFIG_CPUSETS_V1=y
CONFIG_BLK_CGROUP=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

# BPF (bpfloader and netd fail hard without these)
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
# Tracepoint BPF programs (gpuMem, time_in_state) and atrace
CONFIG_FTRACE=y
CONFIG_PERF_EVENTS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y

# Networking for netd: copy the full IP_NF/IP6_NF/NETFILTER_XT/NF_CONNTRACK/XFRM list
# from android-base.config, with IP_NF_IPTABLES_LEGACY=y and IP6_NF_IPTABLES_LEGACY=y.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
CONFIG_IPV6_OPTIMISTIC_DAD=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_INET_UDP_DIAG=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_NS=y
CONFIG_TUN=y
CONFIG_VETH=y

# File systems
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_VERITY=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_CTS=y
CONFIG_CRYPTO_ADIANTUM=y
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y
CONFIG_QUOTACTL=y
CONFIG_FUSE_FS=y
# mkfs.f2fs enables casefold on /data
CONFIG_UNICODE=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=16
# allnoconfig turns this off; apexd mounts loop devices it holds open for write
CONFIG_BLK_DEV_WRITE_MOUNTED=y
CONFIG_DM_UEVENT=y
CONFIG_RD_XZ=y

# Input
CONFIG_INPUT_UINPUT=y
CONFIG_UHID=y
CONFIG_HID_GENERIC=y

# USB: configfs FunctionFS for adb; the legacy g_cdc must not hold the UDC
# CONFIG_USB_CDC_COMPOSITE is not set
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_NCM=y

# Power: libsuspend and system_suspend need wakelocks even with TARGET_SUPPORTS_SUSPEND := false
CONFIG_PM_SLEEP=y
CONFIG_PM_WAKELOCKS=y

# Misc
CONFIG_TASKSTATS=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y
CONFIG_PROFILING=y
CONFIG_ZRAM_BACKEND_LZ4=y
# Dependencies for the android-base options above
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HIDRAW=y
CONFIG_INPUT_MISC=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y

# minigbm allocates every gralloc buffer as a contiguous dumb buffer on mt6739-dbi
CONFIG_CMA_SIZE_MBYTES=96

# Default m, not used on this phone
# CONFIG_COMMON_CLK_MT8196 is not set
# CONFIG_ARM_MEDIATEK_CPUFREQ_HW is not set
# CONFIG_IPV6_SIT is not set
# CONFIG_EFI is not set
# CONFIG_HW_RANDOM is not set
