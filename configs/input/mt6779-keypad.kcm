# NUMERIC makes TextKeyListener use multi-tap input (TODO: verify on Android 17)
type NUMERIC

key 1 {
    label:                              '1'
    number:                             '1'
    base:                               '1'
}

key 2 {
    label:                              '2'
    number:                             '2'
    base:                               '2'
}

key 3 {
    label:                              '3'
    number:                             '3'
    base:                               '3'
}

key 4 {
    label:                              '4'
    number:                             '4'
    base:                               '4'
}

key 5 {
    label:                              '5'
    number:                             '5'
    base:                               '5'
}

key 6 {
    label:                              '6'
    number:                             '6'
    base:                               '6'
}

key 7 {
    label:                              '7'
    number:                             '7'
    base:                               '7'
}

key 8 {
    label:                              '8'
    number:                             '8'
    base:                               '8'
}

key 9 {
    label:                              '9'
    number:                             '9'
    base:                               '9'
}

key 0 {
    label:                              '0'
    number:                             '0'
    base:                               '0'
}

key STAR {
    label:                              '*'
    number:                             '*'
    base:                               '*'
}

key POUND {
    label:                              '#'
    number:                             '#'
    base:                               '#'
}
