# Linux key codes from mt6739-agm-m7.dts (linux,keymap), see docs/NOTES.md "Keypad"

# Soft keys
key 139   MENU
key 158   BACK

# D-pad
key 103   DPAD_UP
key 108   DPAD_DOWN
key 105   DPAD_LEFT
key 106   DPAD_RIGHT
key 28    DPAD_CENTER

# TODO: Wi-Fi only build has no dialer; HOME is a proposal, CALL is the natural mapping
key 231   HOME

# Digits
key 2     1
key 3     2
key 4     3
key 5     4
key 6     5
key 7     6
key 8     7
key 9     8
key 10    9
key 11    0
key 522   STAR
key 523   POUND

# TODO: side key, maybe CAMERA or a flashlight toggle
key 87    F11
