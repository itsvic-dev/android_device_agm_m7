# Modem NVRAM file service and its seed script
type ccci_fsd, domain;
type ccci_fsd_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(ccci_fsd)

allow ccci_fsd ccci_device:chr_file rw_file_perms;
allow ccci_fsd vendor_ccci_fs_data_file:dir create_dir_perms;
allow ccci_fsd vendor_ccci_fs_data_file:file create_file_perms;
allow ccci_fsd vendor_data_file:dir rw_dir_perms;
r_dir_file(ccci_fsd, vendor_nvdata_file)
allow ccci_fsd vendor_shell_exec:file rx_file_perms;
allow ccci_fsd mnt_vendor_file:dir search;
allow ccci_fsd vendor_toolbox_exec:file rx_file_perms;
